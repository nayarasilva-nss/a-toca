{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/responder",
      "destination": "/index.html"
    },
    {
      "source": "/aplicar",
      "destination": "/index.html"
    },
    {
      "source": "/pedir",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/lembrete",
      "schedule": "0 10 * * *"
    }
  ]
}
